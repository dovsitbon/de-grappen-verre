---
import { jours, fmtCreneau } from '../lib/horaires';
interface Props { lang?: 'fr' | 'en' }
const { lang = 'fr' } = Astro.props;
const L = lang === 'en'
  ? { cap: 'Opening hours', midi: 'Lunch', soir: 'Dinner', ferme: 'Closed' }
  : { cap: "Horaires d'ouverture", midi: 'Midi', soir: 'Soir', ferme: 'Fermé' };
---
<table class="horaires w-full border-collapse text-left">
  <caption class="sr-only">{L.cap}</caption>
  <thead>
    <tr class="border-b-2 border-bouteille text-sm">
      <th scope="col" class="py-2 pr-3 font-semibold"><span class="sr-only">{lang === 'en' ? 'Day' : 'Jour'}</span></th>
      <th scope="col" class="py-2 pr-3 font-semibold">{L.midi}</th>
      <th scope="col" class="py-2 font-semibold">{L.soir}</th>
    </tr>
  </thead>
  <tbody>
    {jours.map((j) => (
      <tr data-jour={j.num} class="border-b border-bouteille/25">
        <th scope="row" class="py-2.5 pl-2 pr-3 font-semibold">{lang === 'en' ? j.en : j.jour}</th>
        {j.creneaux.length === 0 ? (
          <td colspan="2" class="py-2.5">{L.ferme}</td>
        ) : (
          <>
            <td class="py-2.5 pr-3 tabular-nums sm:whitespace-nowrap">{j.creneaux[0] ? fmtCreneau(j.creneaux[0], lang) : '—'}</td>
            <td class="py-2.5 tabular-nums sm:whitespace-nowrap">{j.creneaux[1] ? fmtCreneau(j.creneaux[1], lang) : <span class="text-encre/70">{lang === 'en' ? 'no dinner' : 'pas de service'}</span>}</td>
          </>
        )}
      </tr>
    ))}
  </tbody>
</table>
